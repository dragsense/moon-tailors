{
  "name": "@template/server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ./scripts/clear-dev-cache.mjs && nest start --watch",
    "build": "NODE_ENV=production nest build && tsc -p tsconfig.typeorm.json",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"server: no lint configured\"",
    "test": "node --require ts-node/register/transpile-only --test src/modules/auth/__tests__/*.test.ts src/common/encryption/encryption.roundtrip.test.ts src/common/encryption/encryption.db-field.test.ts src/common/logging/__tests__/app-logger.service.test.ts src/config/__tests__/environment.validation.test.ts src/config/__tests__/security-skip.test.ts src/common/query/__tests__/*.test.ts",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/database/data-source.ts",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1105.0",
    "@bull-board/api": "^8.6.0",
    "@bull-board/express": "^8.6.0",
    "@bull-board/nestjs": "^8.6.0",
    "@nestjs-modules/mailer": "^2.0.2",
    "@nestjs/bull": "^11.0.4",
    "@nestjs/common": "^11.0.12",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.12",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "11",
    "@nestjs/microservices": "^11.1.28",
    "@nestjs/platform-express": "^11.0.12",
    "@nestjs/platform-socket.io": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.1.1",
    "@nestjs/typeorm": "^11.0.3",
    "@nestjs/websockets": "^11.1.28",
    "@scalar/nestjs-api-reference": "^1.2.14",
    "@template/contracts": "workspace:*",
    "bcrypt": "^6.0.0",
    "bull": "^4.16.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "cron-parser": "^5.7.0",
    "dotenv": "^16.4.7",
    "express-basic-auth": "^1.2.1",
    "firebase-admin": "^14.2.0",
    "imapflow": "^1.6.6",
    "ioredis": "^5.11.1",
    "luxon": "^3.7.2",
    "mqtt": "^5.15.2",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.4",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "stripe": "^22.4.0",
    "twilio": "^6.0.2",
    "typeorm": "0.3.21",
    "web-push": "^3.6.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@nestjs/schematics": "^11.0.2",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.1",
    "@types/luxon": "^3.7.3",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^8.0.1",
    "@types/web-push": "^3.6.4",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2",
    "webpack": "^5.98.0",
    "webpack-node-externals": "^3.0.0"
  }
}
