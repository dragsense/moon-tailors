{
  "compose": "docker/compose.yml",
  "envDir": "env",
  "environments": {
    "local": {
      "projectName": "moon-tailors",
      "dockerEnv": "env/docker.env",
      "server": {
        "buildTarget": "dev",
        "nodeEnv": "development",
        "restart": "no",
        "env": "env/server.env",
        "needs": ["postgres", "redis"]
      },
      "client": {
        "buildTarget": "dev",
        "nodeEnv": "development",
        "restart": "no",
        "env": "env/client.env"
      },
      "mcp": {
        "buildTarget": "dev",
        "nodeEnv": "development",
        "restart": "no",
        "env": "env/mcp.env"
      },
      "website": {
        "buildTarget": "dev",
        "nodeEnv": "development",
        "restart": "no",
        "env": "env/website.env"
      },
      "gateway": {
        "restart": "no"
      }
    },
    "staging": {
      "projectName": "moon-tailors-staging",
      "dockerEnv": "env/staging/docker.env",
      "server": {
        "buildTarget": "runtime",
        "nodeEnv": "staging",
        "restart": "unless-stopped",
        "env": "env/staging/server.env",
        "needs": ["postgres", "redis"]
      },
      "client": {
        "clientMode": "nginx",
        "buildTarget": "runtime",
        "nodeEnv": "staging",
        "restart": "unless-stopped",
        "env": "env/staging/client.env"
      },
      "mcp": {
        "buildTarget": "runtime",
        "nodeEnv": "staging",
        "restart": "unless-stopped",
        "env": "env/staging/mcp.env"
      },
      "website": {
        "buildTarget": "runtime",
        "nodeEnv": "staging",
        "restart": "unless-stopped",
        "mode": "docker",
        "env": "env/staging/website.env"
      },
      "gateway": {
        "restart": "unless-stopped"
      }
    }
  }
}
