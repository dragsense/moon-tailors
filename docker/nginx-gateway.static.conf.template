# Production static — website + SPA files on the gateway; Nest is API only.
#   /          /var/www/website
#   /app/      /var/www/client
#   /server/   Nest (/api, /docs)

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

map $http_accept $gw_api_error_uri {
    default               /errors/api.html;
    ~*^application/json\b /errors/api.json;
}

server {
    listen ${GATEWAY_INTERNAL} default_server;
    server_name _;

    resolver 127.0.0.11 valid=10s ipv6=off;
    client_max_body_size 25m;

    location /errors/ {
        root /usr/share/nginx/gateway-www;
        try_files $uri =404;
    }

    location @gw_api_down {
        internal;
        root /usr/share/nginx/gateway-www;
        try_files $gw_api_error_uri =503;
    }

    location = /server { return 302 /server/; }
    location = /api { return 302 /api/; }
    location = /app { return 302 /app/; }

    location /server/ {
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin $http_origin always;
            add_header Access-Control-Allow-Credentials true always;
            add_header Access-Control-Allow-Methods "GET,POST,PUT,PATCH,DELETE,OPTIONS" always;
            add_header Access-Control-Allow-Headers "Authorization,Content-Type,X-Request-Id,X-Timezone,X-CSRF-Token,X-Sender,X-Tenant-Id" always;
            add_header Access-Control-Max-Age 3600 always;
            add_header Content-Length 0;
            add_header Content-Type text/plain;
            return 204;
        }

        set $gw_server server:${SERVER_INTERNAL};
        rewrite ^/server/(.*)$ /$1 break;
        proxy_pass http://$gw_server;
        proxy_http_version 1.1;
        proxy_connect_timeout 3s;
        proxy_read_timeout 60s;
        proxy_intercept_errors on;
        error_page 502 503 504 =502 @gw_api_down;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    # Variable proxy_pass defers Docker DNS until request time so nginx can
    # start (and serve /errors/*) even if `server` is not on the network yet.
    location /api/ {
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin $http_origin always;
            add_header Access-Control-Allow-Credentials true always;
            add_header Access-Control-Allow-Methods "GET,POST,PUT,PATCH,DELETE,OPTIONS" always;
            add_header Access-Control-Allow-Headers "Authorization,Content-Type,X-Request-Id,X-Timezone,X-CSRF-Token,X-Sender,X-Tenant-Id" always;
            add_header Access-Control-Max-Age 3600 always;
            add_header Content-Length 0;
            add_header Content-Type text/plain;
            return 204;
        }

        set $gw_server server:${SERVER_INTERNAL};
        proxy_pass http://$gw_server;
        proxy_http_version 1.1;
        proxy_connect_timeout 3s;
        proxy_read_timeout 60s;
        proxy_intercept_errors on;
        error_page 502 503 504 =502 @gw_api_down;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    location /app/assets/ {
        alias /var/www/client/assets/;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location /app/ {
        alias /var/www/client/;
        index index.html;
        try_files $uri $uri/ /app/index.html;
    }

    location /_astro/ {
        alias /var/www/website/_astro/;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location = /404.html {
        root /var/www/website;
    }

    location / {
        root /var/www/website;
        index index.html;
        error_page 404 /404.html;
        try_files $uri $uri/ =404;
    }
}
