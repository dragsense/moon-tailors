# Production nest (or SSR) — website static; /app reverse-proxied.
# GATEWAY_APP_UPSTREAM = server:PORT (clientMode=nest) or client:PORT (ssr).
#   /          /var/www/website
#   /app/      Nest (SPA from client build, mounted) or SSR Node
#   /server/   Nest (/api, /uploads, /docs)
#   /mcp/ /mailpit/

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

map $http_accept $gw_api_error_uri {
    default               /errors/api.html;
    ~*^application/json\b /errors/api.json;
}

map $http_accept $gw_mcp_error_uri {
    default               /errors/mcp.html;
    ~*^application/json\b /errors/mcp.json;
}

server {
    listen ${GATEWAY_INTERNAL} default_server;
    server_name _;

    resolver 127.0.0.11 valid=10s ipv6=off;
    client_max_body_size 25m;

    location /errors/ {
        root /usr/share/nginx/gateway-www;
        try_files $uri =404;
    }

    location @gw_api_down {
        internal;
        root /usr/share/nginx/gateway-www;
        try_files $gw_api_error_uri =503;
    }

    location @gw_mcp_down {
        internal;
        root /usr/share/nginx/gateway-www;
        try_files $gw_mcp_error_uri =503;
    }

    location @gw_app_down {
        internal;
        root /usr/share/nginx/gateway-www;
        try_files /errors/app.html =503;
    }

    location = /server { return 302 /server/; }
    location = /api { return 302 /api/; }
    location = /uploads { return 302 /uploads/; }
    location = /mcp { return 302 /mcp/; }
    location = /app { return 302 /app/; }
    location = /mailpit { return 302 /mailpit/; }

    location /server/ {
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin $http_origin always;
            add_header Access-Control-Allow-Credentials true always;
            add_header Access-Control-Allow-Methods "GET,POST,PUT,PATCH,DELETE,OPTIONS" always;
            add_header Access-Control-Allow-Headers "Authorization,Content-Type,X-Request-Id,X-Timezone,X-CSRF-Token,X-Sender,X-Api-Key,X-Tenant-Id" always;
            add_header Access-Control-Max-Age 3600 always;
            add_header Content-Length 0;
            add_header Content-Type text/plain;
            return 204;
        }

        set $gw_server server:${SERVER_INTERNAL};
        rewrite ^/server/(.*)$ /$1 break;
        proxy_pass http://$gw_server;
        proxy_http_version 1.1;
        proxy_connect_timeout 3s;
        proxy_read_timeout 60s;
        proxy_intercept_errors on;
        error_page 502 503 504 =502 @gw_api_down;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    location /api/ {
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin $http_origin always;
            add_header Access-Control-Allow-Credentials true always;
            add_header Access-Control-Allow-Methods "GET,POST,PUT,PATCH,DELETE,OPTIONS" always;
            add_header Access-Control-Allow-Headers "Authorization,Content-Type,X-Request-Id,X-Timezone,X-CSRF-Token,X-Sender,X-Api-Key,X-Tenant-Id" always;
            add_header Access-Control-Max-Age 3600 always;
            add_header Content-Length 0;
            add_header Content-Type text/plain;
            return 204;
        }

        proxy_pass http://server:${SERVER_INTERNAL}/api/;
        proxy_http_version 1.1;
        proxy_connect_timeout 3s;
        proxy_read_timeout 60s;
        proxy_intercept_errors on;
        error_page 502 503 504 =502 @gw_api_down;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    location /uploads/ {
        proxy_pass http://server:${SERVER_INTERNAL}/uploads/;
        proxy_http_version 1.1;
        proxy_connect_timeout 3s;
        proxy_read_timeout 60s;
        proxy_intercept_errors on;
        error_page 502 503 504 =502 @gw_api_down;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /mcp/ {
        set $gw_mcp mcp:${MCP_INTERNAL};
        rewrite ^/mcp/(.*)$ /$1 break;
        proxy_pass http://$gw_mcp;
        proxy_http_version 1.1;
        proxy_connect_timeout 3s;
        proxy_read_timeout 60s;
        proxy_intercept_errors on;
        error_page 502 503 504 =502 @gw_mcp_down;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    location /mailpit/ {
        set $gw_mailpit mailpit:${MAILPIT_UI_INTERNAL};
        proxy_pass http://$gw_mailpit;
        proxy_http_version 1.1;
        proxy_connect_timeout 3s;
        proxy_read_timeout 60s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }

    location /app/ {
        set $gw_app ${GATEWAY_APP_UPSTREAM};
        proxy_pass http://$gw_app;
        proxy_http_version 1.1;
        proxy_connect_timeout 3s;
        proxy_intercept_errors on;
        error_page 502 503 504 =502 @gw_app_down;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 86400;
    }

    location /_astro/ {
        alias /var/www/website/_astro/;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location = /404.html {
        root /var/www/website;
    }

    location / {
        root /var/www/website;
        index index.html;
        error_page 404 /404.html;
        try_files $uri $uri/ =404;
    }
}
