# Website (Astro) — copy to env/website.env (local). Remote stacks use env/<host>/website.env.
# PUBLIC_ENV = environment banner on / (production = hidden).
PUBLIC_SITE_NAME=Moon Tailors & Matching Center
PUBLIC_ENV=development
PUBLIC_SITE_TAGLINE=Bespoke stitching and matching, made simple.
PUBLIC_SITE_DESCRIPTION=Find a customer, take measurements, and follow each order from cutting to delivery.
# Same-origin gateway paths (works on localhost, LAN, and tunnels).
# Use absolute URLs only when the shop/API is on a different host.
PUBLIC_APP_URL=/app
PUBLIC_API_URL=/server/api
