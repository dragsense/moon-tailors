# Website (Astro) — copy to env/website.env (local). Remote stacks use env/<host>/website.env.
# PUBLIC_ENV = environment banner on / (production = hidden).
PUBLIC_SITE_NAME=Template
PUBLIC_ENV=development
PUBLIC_SITE_TAGLINE=Ship the product, not the plumbing.
PUBLIC_SITE_DESCRIPTION=A full-stack monorepo starter with Nest, React Router, contracts, and deploy tooling.
PUBLIC_APP_URL=http://localhost:8088/app
PUBLIC_APP_LOGIN_PATH=/
PUBLIC_APP_SIGNUP_PATH=/signup
