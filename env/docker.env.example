# *_INTERNAL = Docker network only. The only host port is GATEWAY_EXPOSE.
# Local gateway uses 8088 (not 80). On VPS set GATEWAY_EXPOSE=80.
# Paths: / website · /app/ client · /server/ Nest

COMPOSE_PROJECT_NAME=moon-tailors
POSTGRES_VOLUME_NAME=moon_tailors_postgres_data
LOGS_VOLUME_NAME=moon_tailors_server_logs

GATEWAY_INTERNAL=80
GATEWAY_EXPOSE=8088
GATEWAY_DOMAIN=localhost

SERVER_INTERNAL=3000
CLIENT_INTERNAL=5173
WEBSITE_INTERNAL=4321

POSTGRES_INTERNAL=5432
REDIS_INTERNAL=6379

POSTGRES_DB=moon_tailors_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

VITE_API_URL=/server/api

# Watch (server / client / website): compose defaults to native FS events.
# If create/edit/delete is missed under Docker Desktop / WSL, uncomment:
# CHOKIDAR_USEPOLLING=true
# WATCHPACK_POLLING=true
# WATCHPACK_POLL_INTERVAL=250
# TSC_WATCHFILE=FixedPollingInterval
# TSC_WATCHDIRECTORY=FixedPollingInterval
