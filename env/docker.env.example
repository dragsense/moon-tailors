# *_INTERNAL = Docker network only. The only host port is GATEWAY_EXPOSE.
# Local gateway uses 8088 (not 80). On VPS set GATEWAY_EXPOSE=80.
# Paths: / website · /app/ client · /server/ Nest · /mcp/ · /mailpit/ · /hls/ · /webrtc/

COMPOSE_PROJECT_NAME=template
POSTGRES_VOLUME_NAME=template_postgres_data
UPLOADS_VOLUME_NAME=template_uploads
LOGS_VOLUME_NAME=template_server_logs

GATEWAY_INTERNAL=80
GATEWAY_EXPOSE=8088
GATEWAY_DOMAIN=localhost

SERVER_INTERNAL=3000
CLIENT_INTERNAL=5173
WEBSITE_INTERNAL=4321
MCP_INTERNAL=4000

POSTGRES_INTERNAL=5432
REDIS_INTERNAL=6379

MQTT_INTERNAL=1883
MQTT_WS_INTERNAL=9001

MAILPIT_UI_INTERNAL=8025
MAILPIT_SMTP_INTERNAL=1025

# MediaMTX — HLS/WHEP via gateway /hls /webrtc (internal only)
MEDIAMTX_HLS_INTERNAL=8888
MEDIAMTX_WEBRTC_INTERNAL=8889
MEDIAMTX_API_INTERNAL=9997
MEDIAMTX_ICE_INTERNAL=8189
MEDIAMTX_PUBLIC_HOST=localhost
MEDIAMTX_API_USER=admin
MEDIAMTX_API_PASS=admin123

POSTGRES_DB=template_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

VITE_API_URL=http://localhost:8088/server/api
