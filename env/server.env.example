# Runtime env for the server (local Docker). Copy to env/server.env (gitignored).
# Docker ports / DB user+password live in env/docker.env
# Required fields match server EnvironmentVariables DTO.

# ─── Core ─────────────────────────────────────────────────────────────────
NODE_ENV=development
SERVICE_NAME=moon-tailors-server
APP_NAME=Moon Tailors
APP_URL=http://localhost:8088/app
HOST=0.0.0.0
PORT=3000
CORS_ORIGIN=http://localhost:8088
COOKIE_SECRET=dev-cookie-secret-change-me
API_DOCS_ENABLED=true
CSRF_ENABLED=false
CLUSTER_ENABLED=false

# Inside Docker network use service names (postgres / redis).
# Keep in sync with POSTGRES_* in env/docker.env
DATABASE_URL=postgres://postgres:postgres@postgres:5432/moon_tailors_db
REDIS_URL=redis://redis:6379

TYPEORM_SYNC=true

# single_user | single_domain_tenant | multi_domain_tenant
APP_MODE=single_user
# single | multi-database
DB_MODE=single

# ─── Auth / JWT ───────────────────────────────────────────────────────────
JWT_SECRET=dev-jwt-secret-change-me-32chars!!
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=604800
REFRESH_COOKIE_NAME=refresh_token
OTP_TTL_MS=300000
OTP_MAX_ATTEMPTS=5

AUTH_LOGIN_PASSWORD_OTP=true
AUTH_LOGIN_EMAIL_OTP=true
AUTH_PASSWORD_RESET_MODE=otp
AUTH_PASSWORD_RESET_PATH=reset-password
AUTH_PASSWORD_RESET_LINK_TTL_SEC=900
AUTH_API_KEY_ENABLED=true
AUTH_API_KEY_PREFIX=tk_

# ─── Platform owner (seeded once on boot) ─────────────────────────────────
PLATFORM_OWNER_EMAIL=owner@email.com
PLATFORM_OWNER_PASSWORD=change-me-local
PLATFORM_OWNER_FIRST_NAME=Platform
PLATFORM_OWNER_LAST_NAME=Owner

# ─── Encryption ───────────────────────────────────────────────────────────
ENCRYPTION_ENABLED=false
DB_ENCRYPTION_ENABLED=false
ENCRYPTION_KEY=dev-encryption-key-must-be-32chars-min!!
ENCRYPTION_ALGORITHM=aes-256-gcm
ENCRYPTION_AAD=WEB-API
ENCRYPTION_ITERATIONS=100000

# ─── Feature flags ────────────────────────────────────────────────────────
ACTIVITY_LOGS_ENABLED=true
EVENTS_ENABLED=true
CACHE_ENABLED=true
CACHE_PREFIX=moon-tailors
CACHE_DEFAULT_TTL=300

BULL_BOARD_ENABLED=true
BULL_BOARD_ROUTE=queues
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=dev-bull-board

# MQTT unused (no broker in compose); DTO still requires the flag.
MQTT_ENABLED=false

# ─── Mail (Mailpit in Docker) ─────────────────────────────────────────────
MAIL_ENABLED=true
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM=noreply@moon-tailors.local
MAIL_ADMIN_EMAIL=admin@moon-tailors.local

STORAGE_DRIVER=local
UPLOAD_PUBLIC_BASE_URL=http://localhost:8088/server

DEFAULT_PAYMENT_PROCESSOR=stripe
STRIPE_ENABLED=false
DEFAULT_AI_PROCESSOR=openai
