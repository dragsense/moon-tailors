# Copy to env/development/client.env. Compose mounts it at /app/env/client.env.

# Client environment (build-time only).
# Use the gateway origin so the browser stays same-origin with /api.

VITE_API_URL=https://dev.example.com/server/api

# React Router SSR (read by client/react-router.config.ts).
# false = SPA (default local Vite + nginx/nest/cdn builds)
# true  = SSR (local Vite, or when docker clientMode=ssr which forces true)
CLIENT_SSR=false

# Deploy target shown in the UI (production = no banner).
# development | testing | staging | production
VITE_APP_ENV=development

# Stripe (Elements / Connect) — publishable key only
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_…

# Must match server ENCRYPTION_* when ENCRYPTION_ENABLED=true
VITE_ENCRYPTION_KEY=dev-encryption-key-must-be-32chars-min!!
VITE_ENCRYPTION_AAD=WEB-API
VITE_ENCRYPTION_ITERATIONS=100000
