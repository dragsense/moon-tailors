# Copy to env/production/client.env. Compose mounts it at /app/env/client.env.
# Replace example.com before first deploy. Production hides the env banner.

VITE_API_URL=https://example.com/server/api

# React Router SSR (read by client/react-router.config.ts).
# false = SPA (default nginx/nest/cdn builds)
# true  = SSR (only when docker clientMode=ssr, which forces true)
CLIENT_SSR=false

VITE_APP_ENV=production
