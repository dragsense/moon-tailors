# Copy to env/production/website.env. Compose mounts it at /app/env/website.env.
# Replace example.com before first deploy. Production hides the env banner.

PUBLIC_SITE_NAME=Moon Tailors & Matching Center
PUBLIC_ENV=production
PUBLIC_SITE_TAGLINE=Bespoke stitching and matching, made simple.
PUBLIC_SITE_DESCRIPTION=Find a customer, take measurements, and follow each order from cutting to delivery.
# Same-origin gateway paths. Use https://your-domain/... only for split hosting.
PUBLIC_APP_URL=/app
PUBLIC_API_URL=/server/api
