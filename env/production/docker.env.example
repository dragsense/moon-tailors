# Production compose. Copy to env/production/docker.env (gitignored).
# `pnpm remote` uploads this to the VPS at the same path. Do not reuse env/docker.env.
# Replace example.com and passwords before first deploy.

COMPOSE_PROJECT_NAME=moon-tailors-production
POSTGRES_VOLUME_NAME=moon_tailors_production_postgres_data
LOGS_VOLUME_NAME=moon_tailors_production_server_logs

GATEWAY_INTERNAL=80
GATEWAY_EXPOSE=8088
GATEWAY_DOMAIN=example.com
PUBLIC_ORIGIN=https://example.com

SERVER_INTERNAL=3000
CLIENT_INTERNAL=5173
WEBSITE_INTERNAL=4321

POSTGRES_INTERNAL=5432
REDIS_INTERNAL=6379

POSTGRES_DB=moon_tailors_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

VITE_API_URL=https://example.com/server/api
