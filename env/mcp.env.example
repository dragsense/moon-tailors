# MCP server environment
MCP_PORT=4000
# Nest API (include /api). Compose overrides to http://server:3000/api in Docker.
MCP_API_BASE_URL=http://localhost:8088/server/api
# Optional — required for protected tools (tasks_list, tasks_get)
# MCP_API_KEY=tk_...
MCP_SERVER_NAME=template-mcp
MCP_SERVER_VERSION=0.1.0
