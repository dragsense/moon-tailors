# Staging compose. Copy to env/staging/docker.env (gitignored).
# `pnpm remote` uploads this to the VPS at the same path. Do not reuse env/docker.env.

COMPOSE_PROJECT_NAME=template-staging
POSTGRES_VOLUME_NAME=template_staging_postgres_data
UPLOADS_VOLUME_NAME=template_staging_uploads
LOGS_VOLUME_NAME=template_staging_server_logs

GATEWAY_INTERNAL=80
GATEWAY_EXPOSE=8088
GATEWAY_DOMAIN=staging.example.com
PUBLIC_ORIGIN=https://staging.example.com

SERVER_INTERNAL=3000
CLIENT_INTERNAL=5173
WEBSITE_INTERNAL=4321
MCP_INTERNAL=4000

POSTGRES_INTERNAL=5432
REDIS_INTERNAL=6379

MQTT_INTERNAL=1883
MQTT_WS_INTERNAL=9001

MAILPIT_UI_INTERNAL=8025
MAILPIT_SMTP_INTERNAL=1025
MAILPIT_UI_EXPOSE=8025

MEDIAMTX_HLS_INTERNAL=8888
MEDIAMTX_WEBRTC_INTERNAL=8889
MEDIAMTX_API_INTERNAL=9997
MEDIAMTX_ICE_INTERNAL=8189
MEDIAMTX_PUBLIC_HOST=staging.example.com
MEDIAMTX_API_USER=admin
MEDIAMTX_API_PASS=change-me

POSTGRES_DB=template_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

VITE_API_URL=https://staging.example.com/server/api
