# Staging compose. Copy to env/staging/docker.env (gitignored).
# `pnpm remote` uploads this to the VPS at the same path. Do not reuse env/docker.env.

COMPOSE_PROJECT_NAME=moon-tailors-staging
POSTGRES_VOLUME_NAME=moon_tailors_staging_postgres_data
UPLOADS_VOLUME_NAME=moon_tailors_staging_uploads
LOGS_VOLUME_NAME=moon_tailors_staging_server_logs

GATEWAY_INTERNAL=80
GATEWAY_EXPOSE=8088
GATEWAY_DOMAIN=staging.example.com
PUBLIC_ORIGIN=https://staging.example.com

SERVER_INTERNAL=3000
CLIENT_INTERNAL=5173
WEBSITE_INTERNAL=4321
MCP_INTERNAL=4000

POSTGRES_INTERNAL=5432
REDIS_INTERNAL=6379

POSTGRES_DB=moon_tailors_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

VITE_API_URL=https://staging.example.com/server/api
