# Copy to env/staging/client.env. Compose mounts it at /app/env/client.env.

# Client environment (build-time only).
# Use the gateway origin so the browser stays same-origin with /api.

VITE_API_URL=https://staging.example.com/server/api

# React Router SSR (read by client/react-router.config.ts).
# false = SPA (default local Vite + nginx/nest/cdn builds)
# true  = SSR (local Vite, or when docker clientMode=ssr which forces true)
CLIENT_SSR=false

# Deploy target shown in the UI.
VITE_APP_ENV=staging

