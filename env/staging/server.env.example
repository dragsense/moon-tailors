# Copy to env/staging/server.env (gitignored). Docker mounts it at /app/env/server.env.

# Runtime env for the server (local Docker + production).
# Edit env/server.env (gitignored), then: pnpm restart:api
# Docker ports / DB user+password live in env/docker.env
#
# Required fields match server EnvironmentVariables DTO.
# Optional integrations (Stripe, OpenAI, VAPID, Firebase) stay commented.

# ─── Core ─────────────────────────────────────────────────────────────────
NODE_ENV=staging
SERVICE_NAME=template-server
APP_NAME=Template
APP_URL=https://staging.example.com/app
HOST=0.0.0.0
PORT=3000
CORS_ORIGIN=https://staging.example.com
# Public gateway prefix (cookies + uploads). Nest still listens on /api internally.
SERVER_PUBLIC_PATH=/server
COOKIE_SECRET=dev-cookie-secret-change-me
API_DOCS_ENABLED=true

# Scalar API docs (gateway: /server/api/docs). Off in production unless API_DOCS_ENABLED=true.
# SCALAR_THEME=purple
# SCALAR_TITLE=Template API
# SCALAR_DESCRIPTION=Backend template with shared Zod contracts
# SCALAR_SHOW_SIDEBAR=true
# SCALAR_HIDE_DOWNLOAD=false
# SCALAR_HIDE_TRY_IT=false
# SCALAR_LAYOUT=modern

# CSRF: cookie↔header on /auth/refresh + /auth/logout (required).
# true in production; false for local Vite ↔ API cross-origin unless cookies are wired.
CSRF_ENABLED=false
# CSRF_SKIP_PATHS=
# CSRF_PROTECTED_PATHS=^/api/auth/refresh/?$,^/api/auth/logout/?$

CLUSTER_ENABLED=false
# CLUSTER_WORKERS=2
# CLIENT_STATIC_DIR=

# Inside Docker network use service names (postgres / redis).
# Keep in sync with POSTGRES_* in env/docker.env
DATABASE_URL=postgres://postgres:postgres@postgres:5432/template_db
REDIS_URL=redis://redis:6379

# Dev: auto-create tables. Production: set false and run migrations.
TYPEORM_SYNC=true

# Multi-tenant
# single_user | single_domain_tenant (x-tenant-id) | multi_domain_tenant (subdomain)
APP_MODE=single_user
# single | multi-database
DB_MODE=single
# RESERVED_SUBDOMAINS=www,api,app,staging,testing,admin

# ─── Auth / JWT ───────────────────────────────────────────────────────────
JWT_SECRET=dev-jwt-secret-change-me-32chars!!
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=604800
REFRESH_COOKIE_NAME=refresh_token
OTP_TTL_MS=300000
OTP_MAX_ATTEMPTS=5

AUTH_LOGIN_PASSWORD_OTP=true
AUTH_LOGIN_EMAIL_OTP=true
AUTH_PASSWORD_RESET_MODE=otp
AUTH_PASSWORD_RESET_PATH=reset-password
AUTH_PASSWORD_RESET_LINK_TTL_SEC=900
AUTH_API_KEY_ENABLED=true
AUTH_API_KEY_PREFIX=tk_

# ─── Platform owner (seeded once by UsersModule on boot) ───────────────────
PLATFORM_OWNER_EMAIL=owner@email.com
PLATFORM_OWNER_PASSWORD=admin123
PLATFORM_OWNER_FIRST_NAME=Platform
PLATFORM_OWNER_LAST_NAME=Owner

# ─── Encryption ───────────────────────────────────────────────────────────
# API response envelope (client decrypts with VITE_ENCRYPTION_*).
ENCRYPTION_ENABLED=false
# At-rest field encryption for sensitive columns (e.g. camera passwords).
# Independent of ENCRYPTION_ENABLED — either flag requires ENCRYPTION_KEY (≥32 chars).
DB_ENCRYPTION_ENABLED=false
ENCRYPTION_KEY=dev-encryption-key-must-be-32chars-min!!
ENCRYPTION_ALGORITHM=aes-256-gcm
ENCRYPTION_AAD=WEB-API
ENCRYPTION_ITERATIONS=100000
# ENCRYPTION_SKIP_PATHS=^/api/files/.+/download$

# ─── Feature flags ────────────────────────────────────────────────────────
ACTIVITY_LOGS_ENABLED=true
EVENTS_ENABLED=true
CACHE_ENABLED=true
CACHE_PREFIX=template
CACHE_DEFAULT_TTL=300
# CACHE_DB=1

BULL_BOARD_ENABLED=true
BULL_BOARD_ROUTE=queues
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=dev-bull-board

# ─── MQTT ─────────────────────────────────────────────────────────────────
MQTT_ENABLED=false
MQTT_URL=mqtt://mqtt:1883
MQTT_CLIENT_ID=template-mqtt-server
MQTT_PUBLISHER_CLIENT_ID=template-mqtt-publisher
MQTT_TOPICS=template/#

# ─── Mail (Mailpit in Docker) ─────────────────────────────────────────────
# UI: http://localhost:${GATEWAY_EXPOSE:-8088}/mailpit/
MAIL_ENABLED=true
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM=noreply@template.local
MAIL_ADMIN_EMAIL=admin@template.local
# MAIL_USER=
# MAIL_PASS=
# MAIL_DKIM_DOMAIN=example.com
# MAIL_DKIM_SELECTOR=default
# MAIL_DKIM_PRIVATE_KEY_PATH=/root/private.key

# IMAP inbox receive (optional — platform mailbox, cron every 10m + POST /api/email/sync)
# MAIL_IMAP_ENABLED=false
# MAIL_IMAP_SYNC_ENABLED=true
# MAIL_IMAP_HOST=imap.example.com
# MAIL_IMAP_PORT=993
# MAIL_IMAP_SECURE=true
# MAIL_IMAP_USER=  # defaults to MAIL_USER
# MAIL_IMAP_PASS=  # defaults to MAIL_PASS
# MAIL_IMAP_INBOX_FOLDER=INBOX

# ─── File uploads (local disk or S3) ───────────────────────────────────────
STORAGE_DRIVER=local
UPLOAD_PUBLIC_BASE_URL=http://localhost:8088/server
# UPLOAD_LOCAL_ROOT=/app/public
# When STORAGE_DRIVER=s3 these four are required:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=
# AWS_S3_PUBLIC_URL=
# AWS_S3_ENDPOINT=
# AWS_S3_FORCE_PATH_STYLE=false

# ─── Processors (env = source of truth for platform / default business) ───
# On boot, the isPlatform business gets paymentProcessorId / aiProcessorId
# from these DEFAULT_* types. Secrets stay in env — never stored on business.
DEFAULT_PAYMENT_PROCESSOR=stripe
STRIPE_ENABLED=false
# When STRIPE_ENABLED=true these are required:
# STRIPE_SECRET_KEY=sk_test_…
# STRIPE_PUBLISHABLE_KEY=pk_test_…
# STRIPE_WEBHOOK_SECRET=whsec_…

DEFAULT_AI_PROCESSOR=openai
# OPENAI_API_KEY=sk-…
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# ─── Twilio SMS inbox (optional) ──────────────────────────────────────────
# TWILIO_ACCOUNT_SID=AC…
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=+1…
# Point the Twilio number's Messaging webhook (POST) at:
# TWILIO_SMS_WEBHOOK_URL=https://your-host/server/api/sms/webhook/twilio
# TWILIO_SMS_WEBHOOK_FALLBACK_URL=https://your-host/server/api/sms/webhook/twilio/fallback

# ─── Push (optional) ──────────────────────────────────────────────────────
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_EMAIL=mailto:admin@example.com
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── MediaMTX (camera streams) ────────────────────────────────────────────
# Nest → MediaMTX API on Docker network. Browser → gateway /hls + /webrtc.
MEDIAMTX_HOST=mediamtx
MEDIAMTX_API_PORT=9997
MEDIAMTX_HLS_PORT=8888
MEDIAMTX_WEBRTC_PORT=8889
MEDIAMTX_PUBLIC_HOST=localhost
MEDIAMTX_API_USER=admin
MEDIAMTX_API_PASS=admin123
MEDIAMTX_SOURCE_ON_DEMAND_CLOSE_AFTER=30s
