# Copy to env/staging/server.env (gitignored). Docker mounts it at /app/env/server.env.
# Required fields match server EnvironmentVariables DTO.
# Docker ports / DB user+password live in env/staging/docker.env.

# ─── Core ─────────────────────────────────────────────────────────────────
NODE_ENV=staging
SERVICE_NAME=moon-tailors-server
APP_NAME=Moon Tailors
APP_URL=https://staging.example.com/app
HOST=0.0.0.0
PORT=3000
CORS_ORIGIN=https://staging.example.com
COOKIE_SECRET=change-me-cookie-secret-32chars
API_DOCS_ENABLED=true
CSRF_ENABLED=true
CLUSTER_ENABLED=false

DATABASE_URL=postgres://postgres:change-me@postgres:5432/moon_tailors_db
REDIS_URL=redis://redis:6379

TYPEORM_SYNC=true

APP_MODE=single_user
DB_MODE=single

# ─── Auth / JWT ───────────────────────────────────────────────────────────
JWT_SECRET=change-me-jwt-secret-must-be-32chars!!
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=604800
REFRESH_COOKIE_NAME=refresh_token
OTP_TTL_MS=300000
OTP_MAX_ATTEMPTS=5

AUTH_LOGIN_PASSWORD_OTP=true
AUTH_LOGIN_EMAIL_OTP=true
AUTH_PASSWORD_RESET_MODE=otp
AUTH_PASSWORD_RESET_PATH=reset-password
AUTH_PASSWORD_RESET_LINK_TTL_SEC=900
AUTH_API_KEY_ENABLED=true
AUTH_API_KEY_PREFIX=tk_

PLATFORM_OWNER_EMAIL=owner@email.com
PLATFORM_OWNER_PASSWORD=change-me
PLATFORM_OWNER_FIRST_NAME=Platform
PLATFORM_OWNER_LAST_NAME=Owner

ENCRYPTION_ENABLED=false
DB_ENCRYPTION_ENABLED=false
ENCRYPTION_KEY=change-me-encryption-key-must-be-32chars-min!!
ENCRYPTION_ALGORITHM=aes-256-gcm
ENCRYPTION_AAD=WEB-API
ENCRYPTION_ITERATIONS=100000

ACTIVITY_LOGS_ENABLED=true
EVENTS_ENABLED=true
CACHE_ENABLED=true
CACHE_PREFIX=moon-tailors
CACHE_DEFAULT_TTL=300

BULL_BOARD_ENABLED=true
BULL_BOARD_ROUTE=queues
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=change-me-bull-board

MQTT_ENABLED=false

MAIL_ENABLED=true
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM=noreply@moon-tailors.local
MAIL_ADMIN_EMAIL=admin@moon-tailors.local

STORAGE_DRIVER=local
UPLOAD_PUBLIC_BASE_URL=https://staging.example.com/server

DEFAULT_PAYMENT_PROCESSOR=stripe
STRIPE_ENABLED=false
DEFAULT_AI_PROCESSOR=openai
