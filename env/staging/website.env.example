# Copy to env/staging/website.env. Compose mounts it at /app/env/website.env.

# Website (Astro) — remote: env/<host>/website.env; container path is /app/env/website.env.
PUBLIC_SITE_NAME=Moon Tailors & Matching Center
PUBLIC_ENV=staging
PUBLIC_SITE_TAGLINE=Bespoke stitching and matching, made simple.
PUBLIC_SITE_DESCRIPTION=Find a customer, take measurements, and follow each order from cutting to delivery.
PUBLIC_APP_URL=https://staging.example.com/app
PUBLIC_API_URL=https://staging.example.com/server/api
PUBLIC_APP_LOGIN_PATH=/
PUBLIC_APP_DASHBOARD_PATH=/dashboard
