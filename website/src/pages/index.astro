---
import Base from "../layouts/Base.astro";
import SiteShell from "../layouts/global/site-shell.astro";
import { LandingHero } from "../features/landing";
import { getSiteConfig } from "../config";

const site = getSiteConfig();
---

<Base title={site.name} description={site.description}>
  <link
    slot="head"
    rel="preload"
    as="image"
    type="image/webp"
    imagesrcset="/images/hero-cover-800.webp 800w, /images/hero-cover.webp 1280w"
    imagesizes="100vw"
    fetchpriority="high"
  />
  <SiteShell>
    <LandingHero />
  </SiteShell>
</Base>
