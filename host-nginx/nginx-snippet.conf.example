# Host / main nginx — when Docker gateway itself is down.
#
# This folder is OUTSIDE docker/ on purpose.
# Docker nginx cannot serve anything if Docker (or the gateway container) is stopped.
# Install the HTML onto the host filesystem and point host nginx at it.
#
# Streams (/hls, /webrtc), /api, /app, etc. are all served by the Docker gateway.
# Host nginx only proxies to that gateway (and shows gateway-down.html when it is down).
#
#   sudo mkdir -p /var/www/template
#   sudo cp host-nginx/gateway-down.html /var/www/template/
#
# Local Docker gateway listens on GATEWAY_EXPOSE (default 8088).
# On a VPS you may proxy :80/:443 → 127.0.0.1:80 (GATEWAY_EXPOSE=80).

server {
    listen 80;
    server_name _;

    # Static fallback page on the HOST (not inside any container)
    location = /gateway-down.html {
        root /var/www/template;
        internal;   # only via error_page; drop "internal" to open in browser
    }

    location / {
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Local default: Docker gateway on 8088
        proxy_pass http://127.0.0.1:8088;

        proxy_intercept_errors on;
        error_page 502 503 504 =502 /gateway-down.html;
    }
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}
